<h1>Flats</h1>

<div class="row">
    <% @flats.each do |flat| %>
        <div class="col-4 mb-4">
            <div class="card h-100"> 
                <img src="<%= flat["imageUrl"] %>" class="card-img-top" alt="<%= flat["name"] %>">
                <div class="card-body d-flex flex-column justify-content-between">
                    <h5 class="card-title"><%= flat["name"] %></h5>
                    <%= link_to "Visit flat", flat_path(flat["id"]), class: "btn btn-primary"  %>
                </div>
            </div>
        </div>
    <% end %> 
</div>
